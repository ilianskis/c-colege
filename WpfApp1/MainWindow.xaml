<Window x:Class="HotelManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учета номеров и бронирований"
        Height="820" Width="1280"
        Background="#0F172A" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBg}"/>
            <Setter Property="AlternatingRowBackground" Value="#293548"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Система учета номеров, клиентов и бронирований" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    <TextBlock Text="Управление комнатами, гостями, бронированиями и отчетом" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Открыть отчет" Click="BtnOpenReport_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Номера">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Text="Номер комнаты"/>
                                <TextBox x:Name="txtRoomNumber"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Тип номера"/>
                                <TextBox x:Name="txtRoomType"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Вместимость"/>
                                <TextBox x:Name="txtRoomCapacity"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Цена за ночь"/>
                                <TextBox x:Name="txtRoomPrice"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Добавить" Click="BtnAddRoom_Click"/>
                                <Button Content="Изменить" Click="BtnUpdateRoom_Click"/>
                                <Button Content="Удалить" Click="BtnDeleteRoom_Click" Background="{StaticResource DangerColor}" Foreground="White"/>
                                <Button Content="Очистить" Click="BtnClearRoom_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="Фильтр по номеру"/>
                            <TextBox x:Name="txtRoomFilterNumber" Width="120"/>
                            <TextBlock Text="Тип"/>
                            <TextBox x:Name="txtRoomFilterType" Width="120"/>
                            <TextBlock Text="Вместимость"/>
                            <TextBox x:Name="txtRoomFilterCapacity" Width="100"/>
                            <TextBlock Text="Макс. цена"/>
                            <TextBox x:Name="txtRoomFilterPrice" Width="100"/>
                            <Button Content="Применить фильтр" Click="BtnFilterRooms_Click"/>
                            <Button Content="Сбросить" Click="BtnClearRoomFilter_Click"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="dgRooms" Grid.Row="2" SelectionChanged="DgRooms_SelectionChanged"/>
                </Grid>
            </TabItem>

            <TabItem Header="Клиенты">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Text="Фамилия"/>
                                <TextBox x:Name="txtClientLastName"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Имя"/>
                                <TextBox x:Name="txtClientFirstName"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Телефон"/>
                                <TextBox x:Name="txtClientPhone"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Серия и номер паспорта"/>
                                <TextBox x:Name="txtClientPassport" Width="220"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Добавить" Click="BtnAddClient_Click"/>
                                <Button Content="Изменить" Click="BtnUpdateClient_Click"/>
                                <Button Content="Удалить" Click="BtnDeleteClient_Click" Background="{StaticResource DangerColor}" Foreground="White"/>
                                <Button Content="Очистить" Click="BtnClearClient_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="Поиск по имени или телефону"/>
                            <TextBox x:Name="txtClientSearch" Width="240" TextChanged="TxtClientSearch_TextChanged"/>
                            <Button Content="Сбросить" Click="BtnClearClientSearch_Click"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="dgClients" Grid.Row="2" SelectionChanged="DgClients_SelectionChanged"/>
                </Grid>
            </TabItem>

            <TabItem Header="Бронирования">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Text="Номер"/>
                                <ComboBox x:Name="cmbReservationRoom" DisplayMemberPath="DisplayName" SelectedValuePath="IdCamera"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Клиент"/>
                                <ComboBox x:Name="cmbReservationClient" DisplayMemberPath="DisplayName" SelectedValuePath="IdClient"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Дата заезда"/>
                                <DatePicker x:Name="dpCheckIn"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Дата выезда"/>
                                <DatePicker x:Name="dpCheckOut"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Статус"/>
                                <ComboBox x:Name="cmbReservationStatus">
                                    <ComboBoxItem Content="Подтверждено"/>
                                    <ComboBoxItem Content="Отменено"/>
                                    <ComboBoxItem Content="Завершено"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Добавить" Click="BtnAddReservation_Click"/>
                                <Button Content="Изменить" Click="BtnUpdateReservation_Click"/>
                                <Button Content="Отменить" Click="BtnCancelReservation_Click" Background="{StaticResource DangerColor}" Foreground="White"/>
                                <Button Content="Удалить" Click="BtnDeleteReservation_Click" Background="{StaticResource DangerColor}" Foreground="White"/>
                                <Button Content="Очистить" Click="BtnClearReservation_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="Фильтр по номеру"/>
                            <ComboBox x:Name="cmbReservationFilterRoom" DisplayMemberPath="DisplayName" SelectedValuePath="IdCamera" Width="180"/>
                            <TextBlock Text="Фильтр по клиенту"/>
                            <ComboBox x:Name="cmbReservationFilterClient" DisplayMemberPath="DisplayName" SelectedValuePath="IdClient" Width="220"/>
                            <TextBlock Text="С"/>
                            <DatePicker x:Name="dpReservationFrom"/>
                            <TextBlock Text="По"/>
                            <DatePicker x:Name="dpReservationTo"/>
                            <Button Content="Применить фильтр" Click="BtnFilterReservations_Click"/>
                            <Button Content="Сбросить" Click="BtnClearReservationFilter_Click"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="dgReservations" Grid.Row="2" SelectionChanged="DgReservations_SelectionChanged"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
